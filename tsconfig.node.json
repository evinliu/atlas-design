{
  "extends": "@tsconfig/node18/tsconfig.json",
  "include": [
    "vite.config.ts",
    "packages/**/*.config.ts",
    "packages/**/*.config.mts",
    "packages/**/*.config.cjs",
    "packages/core/build/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}